@* Listado de clientes con buscador y filtro por ciudad *@
@* La vista recibe una lista de filas ya armadas por el controlador *@
@model List<ClienteListadoViewModel>
@{
    ViewData["Title"] = "Clientes"; // Título de la pestaña
    var ciudades = (List<string>)ViewBag.Ciudades; // Lista de ciudades que mandó el controlador para el combo
    var hayFiltros = (bool)ViewBag.HayFiltros; // true si hay filtros aplicados
    var existenClientes = (bool)ViewBag.ExistenClientes; // true si la base tiene al menos un cliente
    var puedeEditar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Operador); // Solo admin y operador ven los botones de carga
}

<div class="d-flex justify-content-between align-items-center mb-3"> @* Fila con el título a la izquierda y el botón a la derecha *@
    <h1 class="h3 mb-0">Clientes</h1> @* Título de la página *@
    @* El botón de crear solo aparece si el rol lo permite *@
    @if (puedeEditar)
    {
        <a class="btn btn-primary" asp-action="Create">+ Nuevo cliente</a> @* Botón que lleva a /Clientes/Create *@
    }
</div> @* Fin de la fila *@

<form method="get" class="row g-2 mb-3"> @* Formulario de búsqueda: GET pone los filtros en la URL (se pueden compartir) *@
    <div class="col-md-5"> @* Columna del buscador *@
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre, email o teléfono" /> @* Campo de texto; "name=q" es el parámetro que lee el controlador *@
    </div> @* Fin de la columna *@
    <div class="col-md-3"> @* Columna del filtro de ciudad *@
        <select name="ciudad" class="form-select"> @* Combo desplegable de ciudades *@
            <option value="">Todas las ciudades</option> @* Opción vacía = sin filtro *@
            @* Una opción por cada ciudad; queda marcada la que estaba elegida *@
            @foreach (var c in ciudades)
            {
                <option value="@c" selected="@(c == (string?)ViewBag.Ciudad)">@c</option> @* Si "selected" es false, Razor no escribe el atributo *@
            }
        </select> @* Fin del combo *@
    </div> @* Fin de la columna *@
    <div class="col-md-4 d-flex gap-2"> @* Columna de botones *@
        <button class="btn btn-primary flex-fill">Buscar</button> @* Envía el formulario *@
        <a class="btn btn-outline-secondary flex-fill @(hayFiltros ? "" : "disabled")" asp-action="Index">✕ Limpiar filtros</a> @* Quita todos los filtros (deshabilitado si no hay) *@
    </div> @* Fin de la columna *@
</form> @* Fin del formulario *@

@* Tres situaciones: base vacía, filtros sin resultados, o hay resultados *@
@if (!existenClientes)
{
    <div class="alert alert-info"><strong>Todavía no hay clientes cargados.</strong> @if (puedeEditar) { <a asp-action="Create" class="alert-link ms-1">Crear el primero</a> }</div> @* La base está vacía *@
}
else if (Model.Count == 0)
{
    <div class="alert alert-info"><strong>Ningún cliente coincide con la búsqueda.</strong> <a asp-action="Index" class="alert-link ms-1">Limpiar filtros</a></div> @* Hay clientes pero el filtro no encontró ninguno *@
}
else
{
    <div class="card"> @* Tarjeta que contiene la tabla *@
        <div class="table-responsive"> @* Permite desplazar la tabla de costado en el celular *@
            <table class="table table-hover align-middle mb-0"> @* Tabla con efecto al pasar el mouse *@
                <thead> @* Encabezado de la tabla *@
                    <tr><th>Nombre</th><th>Email</th><th>Teléfono</th><th>Ciudad</th><th class="text-center">Pedidos</th><th></th></tr> @* Títulos de las columnas *@
                </thead> @* Fin del encabezado *@
                <tbody> @* Cuerpo de la tabla *@
                    @* Una fila por cada cliente *@
                    @foreach (var c in Model)
                    {
                        <tr> @* Inicio de la fila *@
                            <td><a asp-action="Details" asp-route-id="@c.Id">@c.Nombre</a></td> @* Nombre con enlace a la ficha *@
                            <td>@c.Email</td> @* Email *@
                            <td>@c.Telefono</td> @* Teléfono (vacío si no tiene) *@
                            <td>@c.Ciudad</td> @* Ciudad *@
                            <td class="text-center">@c.CantidadPedidos <span class="small" style="color: var(--gris-azulado)">(@c.PedidosAbiertos abiertos)</span></td> @* Total de pedidos y cuántos siguen abiertos *@
                            <td class="text-end text-nowrap"> @* Columna de acciones alineada a la derecha *@
                                @* Botones de edición solo para admin y operador *@
                                @if (puedeEditar)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a> @* Botón editar *@
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Pedidos" asp-action="Create" asp-route-clienteId="@c.Id">+ Pedido</a> @* Crear pedido para este cliente *@
                                }
                            </td> @* Fin de la columna de acciones *@
                        </tr> @* Fin de la fila *@
                    }
                </tbody> @* Fin del cuerpo *@
            </table> @* Fin de la tabla *@
        </div> @* Fin del contenedor responsive *@
        <div class="card-footer bg-white small" style="color: var(--gris-azulado)">@Model.Count cliente(s)</div> @* Cantidad de resultados *@
    </div> @* Fin de la tarjeta *@
}

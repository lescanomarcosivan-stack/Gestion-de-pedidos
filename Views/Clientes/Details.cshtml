@* Ficha de un cliente con todos sus pedidos y el historial de cambios *@
@* La vista recibe un Cliente con su lista de Pedidos ya cargada *@
@model Cliente
@{
    ViewData["Title"] = Model.Nombre; // El título de la pestaña es el nombre del cliente
    var cambios = (List<RegistroActividad>)ViewBag.Cambios; // Historial de cambios (alta y ediciones) que mandó el controlador
    var puedeEditar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Operador); // Solo admin y operador ven los botones
}

<div class="d-flex justify-content-between align-items-center mb-3"> @* Fila de título y botones *@
    <h1 class="h3 mb-0">@Model.Nombre</h1> @* Nombre del cliente como título *@
    @* Botones solo para quien puede editar *@
    @if (puedeEditar)
    {
        <div> @* Grupo de botones *@
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> @* Ir a editar *@
            <a class="btn btn-primary" asp-controller="Pedidos" asp-action="Create" asp-route-clienteId="@Model.Id">+ Nuevo pedido</a> @* Crear pedido para este cliente *@
        </div> @* Fin del grupo *@
    }
</div> @* Fin de la fila *@

<div class="card mb-4"> @* Tarjeta con los datos del cliente *@
    <div class="card-body"> @* Contenido de la tarjeta *@
        <dl class="row mb-0"> @* Lista de definiciones: etiqueta a la izquierda, valor a la derecha *@
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd> @* Email *@
            <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@(Model.Telefono ?? "—")</dd> @* Teléfono o guion si no tiene *@
            <dt class="col-sm-3">Ciudad</dt><dd class="col-sm-9">@(Model.Ciudad ?? "—")</dd> @* Ciudad o guion *@
            <dt class="col-sm-3">Alta</dt><dd class="col-sm-9">@Formato.Fecha(Model.FechaAlta)</dd> @* Fecha de alta en hora argentina *@
        </dl> @* Fin de la lista *@
    </div> @* Fin del contenido *@
</div> @* Fin de la tarjeta *@

<h2 class="h5">Pedidos (@Model.Pedidos.Count)</h2> @* Subtítulo con la cantidad de pedidos *@
@* Si no tiene pedidos, aviso; si tiene, tabla *@
@if (Model.Pedidos.Count == 0)
{
    <div class="alert alert-info">Este cliente todavía no tiene pedidos.</div> @* Aviso *@
}
else
{
    <div class="card mb-4"> @* Tarjeta con la tabla *@
        <div class="table-responsive"> @* Tabla desplazable en celular *@
            <table class="table table-hover align-middle mb-0"> @* Tabla de pedidos *@
                <thead><tr><th>#</th><th>Descripción</th><th class="text-end">Monto</th><th>Estado</th><th>Creado</th></tr></thead> @* Encabezados *@
                <tbody> @* Cuerpo *@
                    @* Una fila por pedido *@
                    @foreach (var p in Model.Pedidos)
                    {
                        <tr class="@(p.Estado == EstadoPedido.Cancelado ? "fila-cancelada" : "")"> @* Fila (rojo suave si está cancelado) *@
                            <td><a asp-controller="Pedidos" asp-action="Details" asp-route-id="@p.Id">@p.Id</a></td> @* Número con enlace al detalle *@
                            <td>@p.Descripcion</td> @* Descripción *@
                            <td class="text-end num text-nowrap @(p.Estado == EstadoPedido.Cancelado ? "monto-cancelado" : "")">@Formato.Moneda(p.Monto)</td> @* Monto (tachado en rojo si está cancelado) *@
                            <td><partial name="_EstadoBadge" model="p.Estado" /></td> @* Etiqueta de color del estado (vista parcial) *@
                            <td>@Formato.Fecha(p.FechaCreacion)</td> @* Fecha de creación *@
                        </tr> @* Fin de la fila *@
                    }
                </tbody> @* Fin del cuerpo *@
            </table> @* Fin de la tabla *@
        </div> @* Fin del contenedor *@
    </div> @* Fin de la tarjeta *@
}

<h2 class="h5">Historial de cambios</h2> @* Subtítulo *@
@* Lista de cambios registrados en la bitácora para este cliente *@
@if (cambios.Count == 0)
{
    <p class="small" style="color: var(--gris-azulado)">Sin cambios registrados (los clientes de ejemplo se cargaron al iniciar la app).</p> @* Aviso *@
}
else
{
    <ul class="list-group mb-4 small"> @* Lista *@
        @* Un renglón por cambio *@
        @foreach (var r in cambios)
        {
            <li class="list-group-item"><strong>@Formato.Fecha(r.Fecha)</strong> · @r.Accion · <span style="color: var(--gris-azulado)">@r.Usuario</span><div>@r.Detalle</div></li> @* Fecha, acción, usuario y detalle *@
        }
    </ul> @* Fin de la lista *@
}
<a asp-action="Index">← Volver a clientes</a> @* Enlace para volver al listado *@

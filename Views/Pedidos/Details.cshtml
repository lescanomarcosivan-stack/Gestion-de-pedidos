@* Detalle de un pedido: datos propios, cambio de estado, seguimiento externo e historial de estados *@
@* La vista recibe el ViewModel con el pedido, el resultado de la API y el historial *@
@model PedidoDetalleViewModel
@{
    var p = Model.Pedido; // Atajo para escribir menos: "p" es el pedido
    ViewData["Title"] = $"Pedido #{p.Id}"; // Título de la pestaña
    var puedeEditar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Operador); // Solo admin y operador pueden cambiar el estado
}

<div class="d-flex justify-content-between align-items-center mb-3"> @* Fila de título *@
    <h1 class="h3 mb-0">Pedido #@p.Id <partial name="_EstadoBadge" model="p.Estado" /></h1> @* Número de pedido y su estado *@
    <a asp-action="Index">← Volver a pedidos</a> @* Volver al listado *@
</div> @* Fin de la fila *@

<div class="row g-3"> @* Grilla de dos columnas *@
    <div class="col-lg-7"> @* Columna izquierda (más ancha) *@
        <div class="card h-100"> @* Tarjeta de datos del pedido *@
            <div class="card-header">Datos del pedido</div> @* Título de la tarjeta *@
            <div class="card-body"> @* Contenido *@
                <dl class="row"> @* Lista etiqueta/valor *@
                    <dt class="col-sm-4">Cliente</dt><dd class="col-sm-8"><a asp-controller="Clientes" asp-action="Details" asp-route-id="@p.ClienteId">@p.Cliente?.Nombre</a></dd> @* Cliente con enlace *@
                    <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@p.Descripcion</dd> @* Descripción *@
                    <dt class="col-sm-4">Monto</dt><dd class="col-sm-8 num @(p.Estado == EstadoPedido.Cancelado ? "monto-cancelado" : "")">@Formato.Moneda(p.Monto)</dd> @* Monto (tachado en rojo si está cancelado) *@
                    <dt class="col-sm-4">Creado</dt><dd class="col-sm-8">@Formato.Fecha(p.FechaCreacion)</dd> @* Fecha de creación *@
                    <dt class="col-sm-4">Actualizado</dt><dd class="col-sm-8">@Formato.Fecha(p.FechaActualizacion)</dd> @* Último cambio (manual o por webhook) *@
                    <dt class="col-sm-4">Entrega programada</dt> @* Fecha de entrega *@
                    <dd class="col-sm-8"> @* Valor *@
                        @Formato.Dia(p.FechaEntrega) @* "15/10/2026" o "—" *@
                        @* Estado del evento en Google Calendar *@
                        @if (p.CalendarioEventoId is not null)
                        {
                            <span class="small ms-2" style="color: var(--azul-700)">📅 en Google Calendar</span> @* Ya está agendado *@
                        }
                        else if (p.FechaEntrega is not null && p.Estado != EstadoPedido.Cancelado && Model.GoogleConectado)
                        {
                            <span class="small ms-2" style="color: var(--gris-azulado)">(agendando… recargá en unos segundos)</span> @* En cola *@
                        }
                    </dd> @* Fin del valor *@
                </dl> @* Fin de la lista *@

                @* El formulario de cambio de estado solo aparece para Administrador u Operador *@
                @if (puedeEditar)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@p.Id" method="post" class="d-flex gap-2"> @* Formulario: POST /Pedidos/CambiarEstado/{id} *@
                        <select name="estado" class="form-select w-auto"> @* Combo de estados *@
                            @* Una opción por estado; queda marcado el actual *@
                            @foreach (var e in Enum.GetValues<EstadoPedido>())
                            {
                                <option value="@e" selected="@(e == p.Estado)">@EstadoMapper.Nombre(e)</option> @* Opción del combo *@
                            }
                        </select> @* Fin del combo *@
                        <button type="submit" class="btn btn-primary">Cambiar estado</button> @* Envía el cambio *@
                    </form> @* Fin del formulario *@

                    <form asp-action="CambiarFechaEntrega" asp-route-id="@p.Id" method="post" class="d-flex flex-wrap gap-2 mt-2"> @* Formulario: POST /Pedidos/CambiarFechaEntrega/{id} *@
                        <input type="date" name="fechaEntrega" value="@p.FechaEntrega?.ToString("yyyy-MM-dd")" min="@ViewBag.Hoy" class="form-control w-auto" aria-label="Fecha de entrega" /> @* Selector de fecha *@
                        <button type="submit" class="btn btn-outline-primary">@(p.FechaEntrega is null ? "Programar entrega" : "Cambiar fecha")</button> @* Guarda la fecha *@
                        @* Quitar solo si hay fecha *@
                        @if (p.FechaEntrega is not null)
                        {
                            <button type="submit" name="quitar" value="true" class="btn btn-link text-danger">Quitar fecha</button> @* Borra la fecha (y el evento de Calendar) *@
                        }
                    </form> @* Fin del formulario *@
                }
                else
                {
                    <p class="small mb-0" style="color: var(--gris-azulado)">Tu rol (Consulta) permite ver el pedido pero no modificarlo.</p> @* Aviso para el rol Consulta *@
                }
            </div> @* Fin del contenido *@
        </div> @* Fin de la tarjeta *@
    </div> @* Fin de la columna izquierda *@

    <div class="col-lg-5"> @* Columna derecha *@
        <div class="card h-100"> @* Tarjeta de seguimiento (datos externos) *@
            <div class="card-header">🚚 Seguimiento (API externa)</div> @* Título de la tarjeta *@
            <div class="card-body"> @* Contenido *@
                @* Qué se muestra depende del estado del pedido *@
                @if (p.Estado == EstadoPedido.Cancelado)
                {
                    <div class="alert alert-secondary mb-0"> @* Pedido cancelado: no hay entrega activa *@
                        <strong>Pedido cancelado.</strong> No hay un envío activo, por eso no se consulta el seguimiento. @* Explicación *@
                    </div> @* Fin del aviso *@
                }
                else if (Model.Tracking is null)
                {
                    <div class="alert alert-warning mb-0">@Model.ErrorTracking</div> @* La API falló: mostramos el error (la página no se rompe) *@
                }
                else
                {
                    <dl class="row mb-2"> @* Lista etiqueta/valor *@
                        <dt class="col-sm-5">Código</dt><dd class="col-sm-7"><code>@Model.Tracking.TrackingCode</code></dd> @* Código de seguimiento *@
                        <dt class="col-sm-5">Transportista</dt><dd class="col-sm-7">@Model.Tracking.Carrier</dd> @* Empresa de transporte *@
                        @* La fecha a mostrar depende de si ya se entregó *@
                        @if (p.Estado == EstadoPedido.Entregado)
                        {
                            <dt class="col-sm-5">Entregado</dt><dd class="col-sm-7">@Formato.Fecha(p.FechaActualizacion)</dd> @* Fecha real de entrega (no la estimada) *@
                        }
                        else
                        {
                            <dt class="col-sm-5">Entrega estimada</dt><dd class="col-sm-7">@Model.Tracking.EstimatedDelivery</dd> @* Fecha estimada que informa la API *@
                        }
                    </dl> @* Fin de la lista *@
                    @* Nota según el estado *@
                    @if (p.Estado is EstadoPedido.Pendiente or EstadoPedido.EnPreparacion)
                    {
                        <p class="small mb-0" style="color: var(--gris-azulado)">El pedido todavía no fue despachado; la fecha es una estimación del transportista.</p> @* Aclaración *@
                    }
                    else if (p.Estado == EstadoPedido.Entregado)
                    {
                        <p class="small mb-0" style="color: var(--gris-azulado)">Envío finalizado.</p> @* Aclaración *@
                    }
                }
            </div> @* Fin del contenido *@
            <div class="card-footer small bg-white" style="color: var(--gris-azulado)">Consultado desde el servidor al abrir esta página.</div> @* Aclaración: la consulta la hace el backend *@
        </div> @* Fin de la tarjeta *@
    </div> @* Fin de la columna derecha *@
</div> @* Fin de la grilla *@

<div class="card mt-3"> @* Tarjeta de productos del pedido *@
    <div class="card-header">Productos</div> @* Título *@
    @* Pedidos de antes de esta versión no tienen renglones *@
    @if (p.Items.Count == 0)
    {
        <div class="card-body small" style="color: var(--gris-azulado)">Pedido cargado antes de la versión con productos: solo tiene descripción y monto.</div> @* Aviso *@
    }
    else
    {
        <div class="table-responsive"> @* Tabla desplazable *@
            <table class="table align-middle mb-0"> @* Tabla *@
                <thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio unit.</th><th class="text-end">Desc.</th><th class="text-end">Subtotal</th></tr></thead> @* Encabezados *@
                <tbody> @* Cuerpo *@
                    @* Un renglón por producto *@
                    @foreach (var i in p.Items)
                    {
                        <tr> @* Fila *@
                            <td><a asp-controller="Productos" asp-action="Details" asp-route-id="@i.ProductoId">@i.ProductoNombre</a></td> @* Producto (nombre copiado al momento de la venta) *@
                            <td class="text-end num">@i.Cantidad</td> @* Cantidad *@
                            <td class="text-end num text-nowrap">@Formato.Moneda(i.PrecioUnitario)</td> @* Precio copiado al momento de la venta *@
                            <td class="text-end num">@(i.DescuentoPorcentaje > 0 ? Formato.Porcentaje(i.DescuentoPorcentaje) : "—")</td> @* Descuento del renglón *@
                            <td class="text-end num text-nowrap">@Formato.Moneda(i.Subtotal)</td> @* Subtotal *@
                        </tr> @* Fin de la fila *@
                    }
                </tbody> @* Fin del cuerpo *@
                <tfoot> @* Totales *@
                    <tr><td colspan="4" class="text-end">Subtotal</td><td class="text-end num text-nowrap">@Formato.Moneda(p.Subtotal)</td></tr> @* Suma de renglones *@
                    @* El descuento general solo se muestra si existe *@
                    @if (p.DescuentoPorcentaje > 0)
                    {
                        <tr><td colspan="4" class="text-end">Descuento general (@Formato.Porcentaje(p.DescuentoPorcentaje))</td><td class="text-end num text-nowrap text-danger">- @Formato.Moneda(Calculos.ImporteDescuentoGeneral(p))</td></tr> @* Importe descontado *@
                    }
                    <tr class="fw-bold"><td colspan="4" class="text-end">Total</td><td class="text-end num text-nowrap @(p.Estado == EstadoPedido.Cancelado ? "monto-cancelado" : "")">@Formato.Moneda(p.Monto)</td></tr> @* Total (tachado si está cancelado) *@
                </tfoot> @* Fin de totales *@
            </table> @* Fin de la tabla *@
        </div> @* Fin del contenedor *@
    }
</div> @* Fin de la tarjeta de productos *@

<div class="card mt-3"> @* Tarjeta de archivos adjuntos *@
    <div class="card-header d-flex justify-content-between align-items-center"> @* Encabezado *@
        <span>📎 Archivos (Google Drive)</span> @* Título *@
        <span class="small" style="color: var(--gris-azulado)">@Model.Archivos.Count archivo(s)</span> @* Cantidad *@
    </div> @* Fin del encabezado *@
    @* Lista de archivos o mensaje *@
    @if (Model.Archivos.Count > 0)
    {
        <ul class="list-group list-group-flush"> @* Lista *@
            @* Un renglón por archivo *@
            @foreach (var a in Model.Archivos)
            {
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2"> @* Renglón *@
                    <div> @* Datos *@
                        <a asp-action="Archivo" asp-route-id="@a.Id">@a.Nombre</a> @* Descarga (pasa por la app) *@
                        <div class="small" style="color: var(--gris-azulado)">@Formato.Tamano(a.Tamano) · @Formato.Fecha(a.Fecha) · @a.Usuario</div> @* Tamaño, fecha y quién lo subió *@
                    </div> @* Fin de los datos *@
                    @* Quitar solo para quien puede editar *@
                    @if (puedeEditar)
                    {
                        <form asp-action="BorrarArchivo" asp-route-id="@a.Id" method="post" class="m-0" onsubmit="return confirmarQuitar(this)"> @* POST /Pedidos/BorrarArchivo/{id} *@
                            <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button> @* Botón *@
                        </form> @* Fin del formulario *@
                    }
                </li> @* Fin del renglón *@
            }
        </ul> @* Fin de la lista *@
    }
    else
    {
        <div class="card-body small pb-0" style="color: var(--gris-azulado)">Este pedido no tiene archivos adjuntos.</div> @* Sin archivos *@
    }
    <div class="card-body"> @* Zona de subida *@
        @* Qué se muestra según el rol y la conexión con Google *@
        @if (!puedeEditar)
        {
            <span class="small" style="color: var(--gris-azulado)">Tu rol (Consulta) permite descargar los archivos pero no subirlos.</span> @* Rol consulta *@
        }
        else if (!Model.GoogleConectado)
        {
            <span class="small" style="color: var(--gris-azulado)">Para adjuntar archivos, un administrador tiene que conectar la cuenta de Google de la empresa (menú <strong>Google</strong>).</span> @* Sin conexión *@
        }
        else
        {
            <form asp-action="SubirArchivo" asp-route-id="@p.Id" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center" id="formArchivo"> @* "multipart/form-data" = formulario que lleva archivos *@
                <input type="file" name="archivo" class="form-control w-auto" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.docx,.doc,.txt,.csv" required id="archivo" /> @* Selector de archivo *@
                <button type="submit" class="btn btn-primary" id="botonSubir">Subir a Drive</button> @* Envía *@
                <span class="small" style="color: var(--gris-azulado)">PDF, imágenes, Excel, Word, TXT o CSV · máximo 10 MB</span> @* Reglas *@
            </form> @* Fin del formulario *@
        }
    </div> @* Fin de la zona de subida *@
</div> @* Fin de la tarjeta de archivos *@

<script>
    // Pide confirmación antes de quitar un archivo
    function confirmarQuitar(formulario) { // Recibe el formulario que se está enviando
        var boton = formulario.querySelector('button'); // Botón "Quitar"
        if (boton.dataset.confirmado) return true; // Segundo clic: se envía
        boton.dataset.confirmado = '1'; // Marcamos el primer clic
        boton.textContent = '¿Seguro? Clic otra vez'; // Pedimos confirmación en el mismo botón (sin ventanas emergentes)
        return false; // Primer clic: no se envía
    } // Fin de la función

    var formArchivo = document.getElementById('formArchivo'); // Formulario de subida (no existe si no hay permiso o conexión)
    if (formArchivo) formArchivo.addEventListener('submit', function (e) { // Al enviar...
        var archivo = document.getElementById('archivo').files[0]; // Archivo elegido
        if (archivo && archivo.size > 10 * 1024 * 1024) { e.preventDefault(); alert('El archivo supera los 10 MB.'); return; } // Avisamos antes de mandarlo
        var boton = document.getElementById('botonSubir'); // Botón
        boton.disabled = true; boton.textContent = 'Subiendo…'; // Evita doble envío y muestra que está trabajando
    }); // Fin del evento
</script>

<div class="card mt-3"> @* Tarjeta del historial *@
    <div class="card-header">Historial de estados</div> @* Título *@
    <div class="table-responsive"> @* Tabla desplazable *@
        <table class="table align-middle mb-0 small"> @* Tabla *@
            <thead><tr><th>Fecha</th><th>Cambio</th><th>Origen</th><th>Usuario</th></tr></thead> @* Encabezados *@
            <tbody> @* Cuerpo *@
                @* Una fila por cada cambio de estado (más nuevo arriba) *@
                @foreach (var h in Model.Historial)
                {
                    <tr> @* Fila *@
                        <td class="text-nowrap">@Formato.Fecha(h.Fecha)</td> @* Cuándo *@
                        <td> @* De qué estado a cuál *@
                            @* En el alta no hay estado anterior *@
                            @if (h.EstadoAnterior is EstadoPedido anterior)
                            {
                                <partial name="_EstadoBadge" model="anterior" /> <span class="mx-1">→</span> @* Estado anterior y flecha *@
                            }
                            <partial name="_EstadoBadge" model="h.EstadoNuevo" /> @* Estado nuevo *@
                        </td> @* Fin de la celda *@
                        <td>@h.Origen</td> @* Alta / Manual / Webhook *@
                        <td>@h.Usuario</td> @* Quién lo hizo *@
                    </tr> @* Fin de la fila *@
                }
            </tbody> @* Fin del cuerpo *@
        </table> @* Fin de la tabla *@
    </div> @* Fin del contenedor *@
</div> @* Fin de la tarjeta *@

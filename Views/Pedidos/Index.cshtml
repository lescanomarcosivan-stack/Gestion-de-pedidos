@* Listado de pedidos con buscador y filtros por estado y fechas *@
@* La vista recibe la lista de pedidos (cada uno con su cliente) *@
@model List<Pedido>
@{
    ViewData["Title"] = "Pedidos"; // Título de la pestaña
    var estadoElegido = ViewBag.Estado as EstadoPedido?; // Estado que estaba filtrado (o null)
}

<div class="d-flex justify-content-between align-items-center mb-3"> @* Fila de título y botón *@
    <h1 class="h3 mb-0">Pedidos</h1> @* Título *@
    <a class="btn btn-primary" asp-action="Create">+ Nuevo pedido</a> @* Botón para crear pedido *@
</div> @* Fin de la fila *@

<form method="get" class="row g-2 mb-3"> @* Filtros: viajan en la URL por GET *@
    <div class="col-md-4"> @* Columna buscador *@
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="N° de pedido, descripción o cliente" /> @* Texto a buscar *@
    </div> @* Fin de la columna *@
    <div class="col-md-3"> @* Columna estado *@
        <select name="estado" class="form-select"> @* Combo de estados *@
            <option value="">Todos los estados</option> @* Sin filtro *@
            @* Una opción por cada valor del enum EstadoPedido *@
            @foreach (var e in Enum.GetValues<EstadoPedido>())
            {
                <option value="@e" selected="@(e == estadoElegido)">@EstadoMapper.Nombre(e)</option> @* value = nombre interno; texto = nombre amigable *@
            }
        </select> @* Fin del combo *@
    </div> @* Fin de la columna *@
    <div class="col-md-2"> @* Columna fecha desde *@
        <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" title="Desde" /> @* Selector de fecha "desde" *@
    </div> @* Fin de la columna *@
    <div class="col-md-2"> @* Columna fecha hasta *@
        <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" title="Hasta" /> @* Selector de fecha "hasta" *@
    </div> @* Fin de la columna *@
    <div class="col-md-1 d-grid"> @* Columna botón *@
        <button class="btn btn-outline-secondary">Filtrar</button> @* Aplica los filtros *@
    </div> @* Fin de la columna *@
</form> @* Fin del formulario *@

@* Aviso si no hay resultados; tabla si los hay *@
@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay pedidos con esos filtros.</div> @* Aviso *@
}
else
{
    <p class="text-muted small">@Model.Count pedido(s)</p> @* Cantidad de resultados *@
    <div class="table-responsive"> @* Tabla desplazable en celular *@
        <table class="table table-hover bg-white align-middle"> @* Tabla *@
            <thead class="table-light"><tr><th>#</th><th>Cliente</th><th>Descripción</th><th class="text-end">Monto</th><th>Estado</th><th>Actualizado</th></tr></thead> @* Encabezados *@
            <tbody> @* Cuerpo *@
                @* Una fila por pedido *@
                @foreach (var p in Model)
                {
                    <tr> @* Fila *@
                        <td><a asp-action="Details" asp-route-id="@p.Id">@p.Id</a></td> @* Número con enlace al detalle *@
                        <td><a asp-controller="Clientes" asp-action="Details" asp-route-id="@p.ClienteId">@p.Cliente?.Nombre</a></td> @* Cliente con enlace a su ficha *@
                        <td>@p.Descripcion</td> @* Descripción *@
                        <td class="text-end">$ @p.Monto.ToString("N2")</td> @* Monto *@
                        <td><partial name="_EstadoBadge" model="p.Estado" /></td> @* Etiqueta del estado *@
                        <td>@EstadoMapper.HoraArgentina(p.FechaActualizacion)</td> @* Último cambio *@
                    </tr> @* Fin de la fila *@
                }
            </tbody> @* Fin del cuerpo *@
        </table> @* Fin de la tabla *@
    </div> @* Fin del contenedor *@
}

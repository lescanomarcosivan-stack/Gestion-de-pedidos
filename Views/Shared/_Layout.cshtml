@* _Layout: el "marco" común de todas las páginas (cabecera, menú y pie). Cada vista se inserta en @RenderBody() *@
<!DOCTYPE html> @* Indica que es un documento HTML5 *@
<html lang="es"> @* Idioma español (ayuda a lectores de pantalla y buscadores) *@
<head> @* Cabecera: configuración que no se ve directamente *@
    <meta charset="utf-8" /> @* Codificación de caracteres: permite tildes y ñ *@
    <meta name="viewport" content="width=device-width, initial-scale=1" /> @* Hace que la página se adapte al celular *@
    <title>@ViewData["Title"] - Gestión de Pedidos</title> @* Título de la pestaña; cada vista define su parte *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /> @* Bootstrap: estilos listos (botones, tablas, grillas) descargados de un CDN *@
</head> @* Fin de la cabecera *@
<body class="bg-light"> @* Cuerpo de la página con fondo gris claro *@
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4"> @* Barra de navegación superior oscura *@
        <div class="container"> @* Contenedor centrado con márgenes *@
            <a class="navbar-brand" asp-controller="Clientes" asp-action="Index">📦 Gestión de Pedidos</a> @* Logo/nombre: lleva al inicio *@
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"> @* Botón "hamburguesa" que aparece en pantallas chicas *@
                <span class="navbar-toggler-icon"></span> @* Ícono de las tres rayitas *@
            </button> @* Fin del botón *@
            <div class="collapse navbar-collapse" id="menu"> @* Menú que se pliega en el celular *@
                <ul class="navbar-nav"> @* Lista de enlaces del menú *@
                    <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li> @* Enlace a /Clientes *@
                    <li class="nav-item"><a class="nav-link" asp-controller="Pedidos" asp-action="Index">Pedidos</a></li> @* Enlace a /Pedidos *@
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Webhooks">Webhooks recibidos</a></li> @* Enlace al historial del webhook *@
                </ul> @* Fin de la lista *@
            </div> @* Fin del menú plegable *@
        </div> @* Fin del contenedor *@
    </nav> @* Fin de la barra de navegación *@

    <main class="container pb-5"> @* Zona principal donde va el contenido de cada página *@
        @* Si una acción anterior dejó un mensaje (ej. "Cliente creado"), se muestra una sola vez *@
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show">@mensaje <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> @* ...lo mostramos en verde, con botón para cerrarlo *@
        }
        @RenderBody() @* Acá se inserta el contenido de la vista actual *@
    </main> @* Fin de la zona principal *@

    <footer class="text-center text-muted small pb-4">Challenge Fullstack · ASP.NET Core + PostgreSQL</footer> @* Pie de página *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> @* JavaScript de Bootstrap (menú plegable, cerrar alertas) *@
</body> @* Fin del cuerpo *@
</html> @* Fin del documento *@

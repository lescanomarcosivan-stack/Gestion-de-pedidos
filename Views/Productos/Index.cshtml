@* Listado de productos con stock, filtros y exportación *@
@* La vista recibe la lista de productos ya filtrada *@
@model List<Producto>
@{
    ViewData["Title"] = "Productos"; // Título de la pestaña
    var puedeEditar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Operador); // Solo admin y operador cargan productos
    var hayFiltros = (bool)ViewBag.HayFiltros; // ¿Hay filtros aplicados?
    var stockBajo = (bool)ViewBag.StockBajo; // Filtro "solo stock bajo"
    var inactivos = (bool)ViewBag.Inactivos; // Filtro "incluir inactivos"
    var cantidadBajo = (int)ViewBag.CantidadStockBajo; // Cuántos productos están en el mínimo
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"> @* Fila de título y botones *@
    <h1 class="h3 mb-0">Productos</h1> @* Título *@
    <div class="d-flex gap-2"> @* Botones *@
        <a class="btn btn-outline-secondary" asp-action="Exportar" asp-route-formato="excel" asp-route-q="@ViewBag.Q" asp-route-stockBajo="@stockBajo" asp-route-inactivos="@inactivos">⬇ Excel</a> @* Descarga el reporte de stock en Excel (con los filtros actuales) *@
        <a class="btn btn-outline-secondary" asp-action="Exportar" asp-route-formato="pdf" asp-route-q="@ViewBag.Q" asp-route-stockBajo="@stockBajo" asp-route-inactivos="@inactivos">⬇ PDF</a> @* Descarga el reporte de stock en PDF *@
        @* Alta solo para quien puede editar *@
        @if (puedeEditar)
        {
            <a class="btn btn-primary" asp-action="Create">+ Nuevo producto</a> @* Alta de producto *@
        }
    </div> @* Fin de los botones *@
</div> @* Fin de la fila *@

@* Aviso de stock bajo (con enlace al filtro) *@
@if (cantidadBajo > 0 && !stockBajo)
{
    <div class="alert alert-danger py-2"><strong>@cantidadBajo producto(s) con stock bajo.</strong> <a class="alert-link" asp-action="Index" asp-route-stockBajo="true">Ver cuáles</a></div> @* Aviso en rojo *@
}

<form method="get" class="row g-2 mb-3 align-items-center"> @* Filtros por GET *@
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre o código" /></div> @* Texto *@
    <div class="col-md-4 d-flex gap-3 text-nowrap"> @* Casillas *@
        <div class="form-check"><input class="form-check-input" type="checkbox" name="stockBajo" value="true" id="fb" @(stockBajo ? "checked" : "") /><label class="form-check-label" for="fb">Solo stock bajo</label></div> @* Filtro stock bajo *@
        <div class="form-check"><input class="form-check-input" type="checkbox" name="inactivos" value="true" id="fi" @(inactivos ? "checked" : "") /><label class="form-check-label" for="fi">Ver inactivos</label></div> @* Incluir inactivos *@
    </div> @* Fin de las casillas *@
    <div class="col-md-4 d-flex gap-2"> @* Botones *@
        <button class="btn btn-primary flex-fill">Filtrar</button> @* Aplica *@
        <a class="btn btn-outline-secondary flex-fill @(hayFiltros ? "" : "disabled")" asp-action="Index">✕ Limpiar filtros</a> @* Quita filtros *@
    </div> @* Fin de los botones *@
</form> @* Fin del formulario *@

@* Base vacía, sin resultados, o tabla *@
@if (!(bool)ViewBag.ExistenProductos)
{
    <div class="alert alert-info"><strong>Todavía no hay productos cargados.</strong></div> @* Base vacía *@
}
else if (Model.Count == 0)
{
    <div class="alert alert-info"><strong>Ningún producto coincide con los filtros.</strong> <a asp-action="Index" class="alert-link ms-1">Limpiar filtros</a></div> @* Sin resultados *@
}
else
{
    <div class="card"> @* Tarjeta con la tabla *@
        <div class="table-responsive"> @* Tabla desplazable *@
            <table class="table table-hover align-middle mb-0"> @* Tabla *@
                <thead><tr><th>Código</th><th>Producto</th><th class="text-end">Precio</th><th class="text-end">Stock</th><th class="text-end">Mínimo</th><th></th></tr></thead> @* Encabezados *@
                <tbody> @* Cuerpo *@
                    @* Una fila por producto *@
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.Activo ? "" : "text-muted")"> @* Inactivos en gris *@
                            <td><code>@p.Codigo</code></td> @* Código *@
                            <td><a asp-action="Details" asp-route-id="@p.Id">@p.Nombre</a> @if (!p.Activo) { <span class="small">(inactivo)</span> }</td> @* Nombre con enlace a la ficha *@
                            <td class="text-end num text-nowrap">@Formato.Moneda(p.Precio)</td> @* Precio *@
                            <td class="text-end num"><span class="@(p.StockBajo ? "estado estado-cancelado" : "")">@Formato.Numero(p.Stock)</span></td> @* Stock (en rojo si está bajo) *@
                            <td class="text-end num" style="color: var(--gris-azulado)">@p.StockMinimo</td> @* Mínimo *@
                            <td class="text-end text-nowrap"> @* Acciones *@
                                @* Editar solo para quien puede *@
                                @if (puedeEditar)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Editar</a> @* Editar datos *@
                                }
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">Stock</a> @* Movimientos de stock *@
                            </td> @* Fin de acciones *@
                        </tr> @* Fin de la fila *@
                    }
                </tbody> @* Fin del cuerpo *@
            </table> @* Fin de la tabla *@
        </div> @* Fin del contenedor *@
        <div class="card-footer bg-white small" style="color: var(--gris-azulado)">@Model.Count producto(s)</div> @* Cantidad *@
    </div> @* Fin de la tarjeta *@
}
